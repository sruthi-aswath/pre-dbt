
-- 1.TRANSFER INFORMATION TABLE FROM SOURCES_PRODUCTION TO WORK ON DATA 

CREATE TABLE SOURCES_DEV.SAP.PRODUCT CLONE SOURCES_PROD.SAP.PRODUCT;

-- 2. INFORMATION AVAILABLE AT SOURCES_DEV IS NOW UTILISED AND TRANSFORM_DEV TABLE CREATED AND CHANGES DONE TO DATA BASED ON REQUIREMENT 

CREATE TABLE TRANSFORM_DEV.SALES.PRODUCT_FILTERS AS

SELECT *
FROM SOURCES_DEV.SAP.PRODUCT
WHERE PRODUCT_ID = '201';

-- 3. CHECK WHETHER CHANGES ARE INCORPORATED AT TABLE BEFORE MOVING TO ACCEPTANCE

SELECT *
FROM TRANSFORM_DEV.SALES.PRODUCT_FILTERS;

-- 4. NOW MOVE TO ACCEPTANCE FOR TESTING. DO SIMILAR WAY DONE FOR DEV.

CREATE TABLE SOURCES_ACC.SAP.PRODUCT CLONE SOURCES_PROD.SAP.PRODUCT;

CREATE TABLE TRANSFORM_ACC.SALES.PRODUCT_FILTERS AS

SELECT *
FROM SOURCES_ACC.SAP.PRODUCT
WHERE PRODUCT_ID = '201';

SELECT *
FROM TRANSFORM_ACC.SALES.PRODUCT_FILTERS;

-- 5.NOW MOVE TO ACCEPTANCE FOR TESTING. DO SIMILAR WAY DONE FOR DEV AND ACC. HERE SOURCE TABLE ALREADY AVAILABLE AT PROD. ONLY CREATE TABLE TRANSFORM_PROD.SALES.PRODUCT_FILTERS

CREATE TABLE TRANSFORM_PROD.SALES.PRODUCT_FILTERS AS

SELECT *
FROM SOURCES_PROD.SAP.PRODUCT
WHERE PRODUCT_ID = '201';

SELECT *
FROM TRANSFORM_PROD.SALES.PRODUCT_FILTERS;

-- SUCCESSFULLY CREATED AND TESTED DATA AT TRANSFORM_DEV, TRANSFORM_ACC, TRANSFORM_PROD
